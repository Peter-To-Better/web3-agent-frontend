# AWS Lambda Function URL that fronts agentcore_stream_proxy.mjs (which
# invokes the Bedrock AgentCore Runtime and streams the response back).
# Leave empty to use the built-in mock chat responses.
# e.g. https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.ap-northeast-1.on.aws/
AGENT_FUNCTION_URL=

# Required by the Function URL above — sent as the `?verify=` query
# parameter on every request, or it responds 401 {"error":"Invalid verify
# token"}. This check isn't in agentcore_stream_proxy.mjs itself, so it's
# enforced by something in front of it (confirm with whoever deployed it).
# Users now enter their own token via the settings icon in the chat UI
# (stored in their browser, sent as the X-Agent-Verify-Token header) —
# this is only a deployment-level fallback for when they haven't yet.
AGENT_FUNCTION_URL_VERIFY_TOKEN=

# Real backend base URL for endpoints not yet served by the Lambda above,
# e.g. chat history. Leave empty to use the built-in mock chat history.
BACKEND_URL=

# Paths appended to BACKEND_URL by the REST proxy routes.
BACKEND_CHAT_HISTORY_PATH=/chat/history
